# 复制到 deploy/.env 后按实际情况修改。
# docker compose 会自动读取同目录下的 .env。

# ---- 应用数据（缩略图缓存 / 临时文件 / config.yaml）----
# 必须放在与代码目录无关的地方，否则重新同步代码会把缓存一起删掉
NASPIC_DATA_DIR=/home/ubuntu/naspic-data

# ---- 宿主机照片目录（容器内只读）----
NASPIC_PHOTOS_DIR=/photos

# ---- MySQL ----
MYSQL_DATA_DIR=/home/ubuntu/naspic-mysql/data
MYSQL_INIT_DIR=./mysql/init
MYSQL_ROOT_PASSWORD=naspic_root_2026
MYSQL_DATABASE=naspic
MYSQL_USER=naspic
MYSQL_PASSWORD=naspic_2026
